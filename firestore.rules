rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: cada usuario lee solo su documento. Admin puede todo.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Logs de acceso: solo lectura admin, escritura desde la app (client SDK)
    match /accessLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete, update: if false;
    }

    // Estadisticas de examenes
    match /examStats/{statId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete, update: if false;
    }

    // Intentos de login fallidos (bloqueo por brute force)
    match /loginAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
